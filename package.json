{
  "name": "nhl-analytics",
  "version": "0.2.0",
  "description": "Local NHL analytics: teams, players, advanced charts and player cards",
  "private": true,
  "license": "MIT",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
